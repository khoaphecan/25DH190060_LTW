@model _25DH190060_LTW.Models.Category

@{
    ViewBag.Title = "Delete";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2 class="bg-success">XÓA DANH MỤC</h2>

<h4 class="alert alert-danger">Bạn thực sự muốn xóa danh mục này à?</h4>

@if (Model.Product != null && Model.Product.Any())
{
    <div class="alert alert-warning">
        <strong>Lưu ý:</strong> Danh mục này hiện đang có <strong>@Model.Product.Count()</strong> sản phẩm trực thuộc. Để bảo toàn tính toàn vẹn dữ liệu, hệ thống sẽ không cho phép xóa danh mục này.
    </div>
}

@using (Html.BeginForm()) {
    @Html.AntiForgeryToken()

    <div class="form-horizontal">
        <div class="form-group">
            <div class="control-label col-md-2 font-weight-bold">Tên danh mục</div>
            <div class="col-md-10" style="margin-top: 5px;">
                @* Hiển thị giá trị của CategoryName *@
                @Html.DisplayFor(model => model.CategoryName)
            </div>
        </div>

        <div class="form-group" style="margin-top: 20px;">
            <div class="col-md-offset-2 col-md-10">
                <input type="submit" value="Xóa" class="btn btn-primary" />
                @Html.ActionLink("Quay lại danh sách", "Index", null, new { @class = "btn btn-primary" })
            </div>
        </div>
    </div>
}
