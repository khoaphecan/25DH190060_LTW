@model _25DH190060_LTW.Models.Order

@{
    ViewBag.Title = "Chi tiết đơn hàng";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<style>
    .order-detail-container {
        margin-top: 15px;
        margin-bottom: 40px;
    }
    .order-detail-title {
        font-size: 26px;
        font-weight: 500;
        color: #222222;
        margin-top: 15px;
        margin-bottom: 25px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }
    .order-info-heading {
        font-size: 15px;
        font-weight: bold;
        color: #222222;
        margin-bottom: 18px;
        text-transform: uppercase;
    }
    .order-info-table {
        width: 100%;
        border-collapse: collapse;
    }
    .order-info-table td {
        padding: 5px 6px;
        font-size: 14px;
        vertical-align: top;
        border: none !important;
        background: transparent !important;
    }
    .order-info-label {
        text-align: right;
        font-weight: 500;
        color: #222222;
        width: 155px;
        padding-right: 18px !important;
        white-space: normal;
        line-height: 1.35;
    }
    .order-info-value {
        text-align: left;
        color: #333333;
        line-height: 1.35;
        word-break: break-word;
    }
    .order-items-table {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 25px;
        border-top: 1px solid #e0e0e0;
    }
    .order-items-table th {
        font-weight: bold;
        font-size: 14px;
        color: #222222;
        padding: 10px 8px;
        border-top: 1px solid #e0e0e0;
        border-bottom: 1px solid #e0e0e0;
        border-left: none !important;
        border-right: none !important;
        background: transparent !important;
        vertical-align: bottom;
        line-height: 1.3;
    }
    .order-items-table td {
        padding: 15px 8px;
        font-size: 14px;
        border-top: none !important;
        border-bottom: 1px solid #ebebeb !important;
        border-left: none !important;
        border-right: none !important;
        vertical-align: middle;
        background: transparent !important;
    }
    .prod-cell {
        display: flex;
        align-items: center;
        gap: 15px;
    }
    .prod-img {
        width: 65px;
        height: 85px;
        object-fit: contain;
        border: 1px solid #f0f0f0;
        background-color: #ffffff;
        flex-shrink: 0;
    }
    .prod-name {
        font-size: 14px;
        color: #333333;
        line-height: 1.4;
    }
    .action-btn-group {
        margin-top: 30px;
        margin-bottom: 20px;
        display: flex;
        gap: 10px;
    }
    .action-btn-group .btn {
        min-width: 150px;
        padding: 7px 18px;
        font-size: 14px;
    }
</style>

<div class="order-detail-container">
    <h2 class="order-detail-title">CHI TIẾT ĐƠN HÀNG</h2>

    <div class="row">
        <!-- Cột trái: THÔNG TIN ĐƠN HÀNG -->
        <div class="col-md-5 col-sm-12 mb-4">
            <div class="order-info-heading">THÔNG TIN ĐƠN HÀNG</div>
            <table class="order-info-table">
                <tbody>
                    <tr>
                        <td class="order-info-label">Ngày đặt hàng</td>
                        <td class="order-info-value">@Model.OrderDate.ToString("M/d/yyyy h:mm:ss tt")</td>
                    </tr>
                    <tr>
                        <td class="order-info-label">Tên khách hàng</td>
                        <td class="order-info-value">@(Model.Customer != null ? Model.Customer.CustomerName : "")</td>
                    </tr>
                    <tr>
                        <td class="order-info-label">Tổng giá trị</td>
                        <td class="order-info-value">@Model.TotalAmount.ToString("F2")</td>
                    </tr>
                    <tr>
                        <td class="order-info-label">Phương thức thanh toán</td>
                        <td class="order-info-value">@Model.PaymentMethod</td>
                    </tr>
                    <tr>
                        <td class="order-info-label">Trạng thái thanh toán</td>
                        <td class="order-info-value">@Model.PaymentStatus</td>
                    </tr>
                    <tr>
                        <td class="order-info-label">Phương thức giao hàng</td>
                        <td class="order-info-value">@Model.ShippingMethod</td>
                    </tr>
                    <tr>
                        <td class="order-info-label">Địa chỉ giao hàng</td>
                        <td class="order-info-value">@Model.ShippingAddress</td>
                    </tr>
                </tbody>
            </table>
        </div>

        <!-- Cột phải: BẢNG SẢN PHẨM TRONG ĐƠN HÀNG -->
        <div class="col-md-7 col-sm-12 mb-4">
            <table class="order-items-table">
                <thead>
                    <tr>
                        <th style="width: 55%; text-align: left;">Sản phẩm</th>
                        <th style="width: 15%; text-align: center;">Số<br />lượng</th>
                        <th style="width: 15%; text-align: right;">Đơn<br />giá</th>
                        <th style="width: 15%; text-align: right;">Thành<br />tiền</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.OrderDetail != null && Model.OrderDetail.Any())
                    {
                        foreach (var item in Model.OrderDetail)
                        {
                            var prodImg = item.Product != null && !string.IsNullOrEmpty(item.Product.ProductImage)
                                ? item.Product.ProductImage
                                : "~/Content/images/default_img.png";
                            var prodName = item.Product != null ? item.Product.ProductName : ("Sản phẩm #" + item.ProductID);
                            var lineTotal = item.TotalPrice.HasValue ? item.TotalPrice.Value : (item.Quantity * item.UnitPrice);

                            <tr>
                                <td>
                                    <div class="prod-cell">
                                        <img src="@Url.Content(prodImg)" alt="@prodName" class="prod-img" />
                                        <span class="prod-name">@prodName</span>
                                    </div>
                                </td>
                                <td style="text-align: center;">@item.Quantity</td>
                                <td style="text-align: right;">@item.UnitPrice.ToString("#,##0")</td>
                                <td style="text-align: right;">@lineTotal.ToString("0")</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" style="text-align: center; color: #888; padding: 25px;">Không có chi tiết sản phẩm nào.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Nút thao tác dưới trang -->
    <div class="action-btn-group">
        @Html.ActionLink("Cập nhật trạng thái", "UpdateStatus", new { id = Model.OrderID }, new { @class = "btn btn-primary" })
        @Html.ActionLink("Quay lại danh sách", "Index", null, new { @class = "btn btn-primary" })
    </div>
</div>
