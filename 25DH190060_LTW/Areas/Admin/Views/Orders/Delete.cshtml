@model _25DH190060_LTW.Models.Order

@{
    ViewBag.Title = "Xóa Đơn Hàng";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2 class="bg-success">XÓA ĐƠN HÀNG #@Model.OrderID</h2>

<div class="alert alert-danger">
    Bạn có chắc chắn muốn xóa đơn hàng này không? Dữ liệu chi tiết đơn hàng sẽ bị xóa và số lượng tồn kho sẽ được hoàn trả.
</div>

<div class="panel panel-default border mb-4">
    <div class="panel-heading bg-light p-2 font-weight-bold">
        Thông Tin Đơn Hàng
    </div>
    <div class="panel-body p-3">
        <dl class="row mb-0">
            <dt class="col-sm-3 font-weight-bold">Mã đơn hàng:</dt>
            <dd class="col-sm-9">#@Model.OrderID</dd>

            <dt class="col-sm-3 font-weight-bold">Ngày đặt hàng:</dt>
            <dd class="col-sm-9">@Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</dd>

            <dt class="col-sm-3 font-weight-bold">Khách hàng:</dt>
            <dd class="col-sm-9">@(Model.Customer != null ? Model.Customer.CustomerName : "N/A")</dd>

            <dt class="col-sm-3 font-weight-bold">Địa chỉ giao hàng:</dt>
            <dd class="col-sm-9">@Model.AddressDelivery</dd>

            <dt class="col-sm-3 font-weight-bold">Trạng thái thanh toán:</dt>
            <dd class="col-sm-9"><span class="badge bg-secondary">@Model.PaymentStatus</span></dd>

            <dt class="col-sm-3 font-weight-bold">Tổng tiền:</dt>
            <dd class="col-sm-9 text-danger font-weight-bold">@Model.TotalAmount.ToString("N0") đ</dd>
        </dl>
    </div>
</div>

<h4 class="mb-3">DANH SÁCH MẶT HÀNG TRONG ĐƠN</h4>
<table class="table table-bordered table-striped">
    <thead>
        <tr class="bg-success">
            <th>Tên sản phẩm</th>
            <th class="text-center" style="width: 100px;">Số lượng</th>
            <th class="text-end" style="width: 140px;">Đơn giá</th>
            <th class="text-end" style="width: 140px;">Thành tiền</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.OrderDetail != null && Model.OrderDetail.Any())
        {
            foreach (var detail in Model.OrderDetail)
            {
                <tr>
                    <td>@(detail.Product != null ? detail.Product.ProductName : "SP #" + detail.ProductID)</td>
                    <td class="text-center">@detail.Quantity</td>
                    <td class="text-end">@detail.UnitPrice.ToString("N0") đ</td>
                    <td class="text-end fw-bold">@((detail.Quantity * detail.UnitPrice).ToString("N0")) đ</td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="4" class="text-center text-muted">Không có chi tiết mặt hàng</td>
            </tr>
        }
    </tbody>
</table>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="form-actions mt-3">
        <input type="submit" value="Xóa đơn hàng" class="btn btn-danger" />
        @Html.ActionLink("Quay lại danh sách", "Index", null, new { @class = "btn btn-secondary" })
    </div>
}
