<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Quản trị Đơn hàng</title>
    @Styles.Render("~/Content/css")
    <link href="~/Content/PagedList.css" rel="stylesheet" type="text/css" />
    @Scripts.Render("~/bundles/modernizr")
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4 py-2">
        <div class="container">
            <a class="navbar-brand py-0 me-4" href="@Url.Action("Index", "Home", new { area = "Admin" })">
                <span style="background: #ffffff; color: #111111; padding: 4px 14px; font-weight: 800; font-size: 18px; letter-spacing: 1px; display: inline-block;">Admin</span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#adminNavbar">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="adminNavbar">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">@Html.ActionLink("HomeAdmin", "Index", "Home", new { area = "Admin" }, new { @class = "nav-link" })</li>
                    <li class="nav-item">@Html.ActionLink("Danh mục", "Index", "Categories", new { area = "Admin" }, new { @class = "nav-link" })</li>
                    <li class="nav-item">@Html.ActionLink("Sản phẩm", "Index", "Products", new { area = "Admin" }, new { @class = "nav-link" })</li>
                    <li class="nav-item">@Html.ActionLink("Khách hàng", "Index", "Customers", new { area = "Admin" }, new { @class = "nav-link" })</li>
                    <li class="nav-item">@Html.ActionLink("Đơn hàng", "Index", "Orders", new { area = "Admin" }, new { @class = "nav-link" })</li>
                    <li class="nav-item">@Html.ActionLink("Tài khoản", "Index", "Users", new { area = "Admin" }, new { @class = "nav-link" })</li>
                </ul>
            </div>
        </div>
    </nav>

    <main class="container body-content">
        @RenderBody()
        <footer class="mt-5 pt-4 border-top">
            <div class="row text-muted" style="font-size: 14px;">
                <div class="col-md-6">
                    <p>2026</p>
                </div>
                <div class="col-md-6 text-end">
                    <h5 class="mb-1 fw-bold text-dark" style="font-size: 15px;">Contact</h5>
                    <p class="mb-0">Trần Nguyễn Anh Khoa</p>
                </div>
            </div>
        </footer>
    </main>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)
</body>
</html>
