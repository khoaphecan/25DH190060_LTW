@model IEnumerable<_25DH190060_LTW.Models.User>

@{
    ViewBag.Title = "Quản Lý Tài Khoản";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2 class="bg-success">QUẢN LÝ TÀI KHOẢN ADMIN</h2>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mt-2" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mt-2" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row mb-3">
    <div class="col-md-6">
        @using (Html.BeginForm("Index", "Users", FormMethod.Get, new { @class = "d-flex gap-2" }))
        {
            <input type="text" name="search" class="form-control" placeholder="Tìm theo tên tài khoản hoặc vai trò..." />
            <button type="submit" class="btn btn-primary">Tìm</button>
        }
    </div>
    <div class="col-md-6 text-end">
        @Html.ActionLink("Thêm tài khoản", "Create", null, new { @class = "btn btn-primary" })
    </div>
</div>

<table class="table table-bordered table-hover">
    <thead class="table-success" style="background-color: #d8ebd2;">
        <tr>
            <th>TÊN ĐĂNG NHẬP</th>
            <th>VAI TRÒ</th>
            <th style="width: 150px; text-align: center;"></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.Username)</td>
                <td>
                    @(item.UserRole == "A" || item.UserRole == "Admin" ? "Quản trị viên (Admin)" : "Khách hàng (Customer)")
                </td>
                <td style="text-align: center;">
                    @Html.ActionLink("Sửa", "Edit", new { id = item.Username }, new { @class = "btn btn-outline-secondary btn-sm" })
                    @Html.ActionLink("Xóa", "Delete", new { id = item.Username }, new { @class = "btn btn-outline-secondary btn-sm" })
                </td>
            </tr>
        }
    </tbody>
</table>
