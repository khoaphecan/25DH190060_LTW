@model _25DH190060_LTW.Models.User

@{
    ViewBag.Title = "Xóa Tài Khoản";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2 class="bg-success">XÓA TÀI KHOẢN</h2>

<h4 class="alert alert-danger">Bạn thực sự muốn xóa tài khoản này à?</h4>

@if (Model.Customer != null && Model.Customer.Any())
{
    <div class="alert alert-warning">
        <strong>Lưu ý:</strong> Tài khoản này đang liên kết với <strong>@Model.Customer.Count()</strong> hồ sơ khách hàng. Để bảo vệ dữ liệu khách hàng, hệ thống sẽ không cho phép xóa tài khoản này.
    </div>
}

<div class="card mb-4">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3 font-weight-bold">Tên đăng nhập:</dt>
            <dd class="col-sm-9">@Model.Username</dd>

            <dt class="col-sm-3 font-weight-bold">Vai trò:</dt>
            <dd class="col-sm-9">
                @(Model.UserRole == "A" || Model.UserRole == "Admin" ? "Quản trị viên (Admin)" : "Khách hàng (Customer)")
            </dd>
        </dl>
    </div>
</div>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="form-actions no-color">
        <input type="submit" value="Xóa" class="btn btn-danger" />
        @Html.ActionLink("Quay lại danh sách", "Index", null, new { @class = "btn btn-outline-secondary" })
    </div>
}
