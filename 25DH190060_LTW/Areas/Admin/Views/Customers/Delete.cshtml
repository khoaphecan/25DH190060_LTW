@model _25DH190060_LTW.Models.Customer

@{
    ViewBag.Title = "Xóa Khách Hàng";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2 class="bg-success">XÓA KHÁCH HÀNG</h2>

<h4 class="alert alert-danger">Bạn thực sự muốn xóa khách hàng này à?</h4>

@if (Model.Order != null && Model.Order.Any())
{
    <div class="alert alert-warning">
        <strong>Lưu ý:</strong> Khách hàng này đã phát sinh <strong>@Model.Order.Count()</strong> đơn hàng trong hệ thống. Để bảo toàn lịch sử giao dịch, hệ thống sẽ không cho phép xóa khách hàng này.
    </div>
}

<div class="card mb-4">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3 font-weight-bold">Mã khách hàng:</dt>
            <dd class="col-sm-9">@Model.CustomerID</dd>

            <dt class="col-sm-3 font-weight-bold">Tài khoản:</dt>
            <dd class="col-sm-9">@Model.Username</dd>

            <dt class="col-sm-3 font-weight-bold">Họ và tên:</dt>
            <dd class="col-sm-9">@Model.CustomerName</dd>

            <dt class="col-sm-3 font-weight-bold">Email:</dt>
            <dd class="col-sm-9">@Model.CustomerEmail</dd>

            <dt class="col-sm-3 font-weight-bold">Điện thoại:</dt>
            <dd class="col-sm-9">@Model.CustomerPhone</dd>
        </dl>
    </div>
</div>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="form-actions no-color">
        <input type="submit" value="Xóa" class="btn btn-danger" />
        @Html.ActionLink("Quay lại danh sách", "Index", null, new { @class = "btn btn-outline-secondary" })
    </div>
}
