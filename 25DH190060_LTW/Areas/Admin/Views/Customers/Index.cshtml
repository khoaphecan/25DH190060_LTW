@model IEnumerable<_25DH190060_LTW.Models.Customer>

@{
    ViewBag.Title = "Quản Lý Khách Hàng";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2 class="bg-success">QUẢN LÝ KHÁCH HÀNG</h2>

<table class="table table-bordered table-hover">
    <thead class="table-success" style="background-color: #d8ebd2;">
        <tr>
            <th style="width: 40px; text-align: center;"><input type="checkbox" id="selectAllCheckbox" onclick="toggleSelectAll(this)" /></th>
            <th class="font-weight-bold">MÃ KH</th>
            <th class="font-weight-bold">HỌ VÀ TÊN</th>
            <th class="font-weight-bold">ĐỊA CHỈ EMAIL</th>
            <th class="font-weight-bold">SỐ ĐIỆN THOẠI</th>
            <th class="font-weight-bold">VAI TRÒ?</th>
            <th style="width: 150px; text-align: center;"></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td style="text-align: center;"><input type="checkbox" class="cust-chk" /></td>
                <td>@(string.IsNullOrEmpty(item.Username) ? item.CustomerID.ToString() : item.Username)</td>
                <td>@Html.DisplayFor(modelItem => item.CustomerName)</td>
                <td>@Html.DisplayFor(modelItem => item.CustomerEmail)</td>
                <td>@Html.DisplayFor(modelItem => item.CustomerPhone)</td>
                <td>@(item.User != null && !string.IsNullOrEmpty(item.User.UserRole) ? item.User.UserRole : "Khách hàng")</td>
                <td style="text-align: center;">
                    @Html.ActionLink("Sửa", "Edit", new { id = item.CustomerID }, new { @class = "btn btn-outline-secondary btn-sm" })
                    @Html.ActionLink("Xóa", "Delete", new { id = item.CustomerID }, new { @class = "btn btn-outline-secondary btn-sm" })
                </td>
            </tr>
        }
    </tbody>
</table>

<div class="d-flex gap-2 mt-3">
    <button type="button" class="btn btn-outline-secondary" onclick="checkAll(true)">Chọn tất cả</button>
    <button type="button" class="btn btn-outline-secondary" onclick="checkAll(false)">Bỏ chọn tất cả</button>
    @Html.ActionLink("Nhập thêm", "Create", null, new { @class = "btn btn-outline-secondary" })
</div>

<script>
    function checkAll(val) {
        document.querySelectorAll('.cust-chk').forEach(c => c.checked = val);
        var selectAll = document.getElementById('selectAllCheckbox');
        if (selectAll) selectAll.checked = val;
    }
    function toggleSelectAll(master) {
        checkAll(master.checked);
    }
</script>
