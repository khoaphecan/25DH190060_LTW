@model IEnumerable<_25DH190060_LTW.Models.Customer>

@{
    ViewBag.Title = "Quản Lý Khách Hàng";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2 class="bg-success">DANH SÁCH KHÁCH HÀNG</h2>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mt-2" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mt-2" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<table class="table table-bordered table-hover mt-3">
    <thead class="table-success" style="background-color: #d8ebd2;">
        <tr>
            <th class="font-weight-bold">MÃ KH</th>
            <th class="font-weight-bold">HỌ VÀ TÊN</th>
            <th class="font-weight-bold">SỐ ĐIỆN THOẠI</th>
            <th class="font-weight-bold">EMAIL</th>
            <th class="font-weight-bold">ĐỊA CHỈ</th>
            <th class="font-weight-bold">TÊN TÀI KHOẢN</th>
            <th style="width: 200px; text-align: center;"></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.CustomerID</td>
                <td>@Html.DisplayFor(modelItem => item.CustomerName)</td>
                <td>@Html.DisplayFor(modelItem => item.CustomerPhone)</td>
                <td>@Html.DisplayFor(modelItem => item.CustomerEmail)</td>
                <td>@Html.DisplayFor(modelItem => item.CustomerAddress)</td>
                <td>@Html.DisplayFor(modelItem => item.Username)</td>
                <td style="text-align: center;">
                    @Html.ActionLink("Sửa", "Edit", new { id = item.CustomerID }, new { @class = "btn btn-primary btn-sm" })
                    @Html.ActionLink("Chi tiết", "Details", new { id = item.CustomerID }, new { @class = "btn btn-primary btn-sm" })
                    @Html.ActionLink("Xóa", "Delete", new { id = item.CustomerID }, new { @class = "btn btn-primary btn-sm" })
                </td>
            </tr>
        }
    </tbody>
</table>

<p class="mt-3">
    @Html.ActionLink("Thêm mới", "Create", null, new { @class = "btn btn-primary" })
</p>
