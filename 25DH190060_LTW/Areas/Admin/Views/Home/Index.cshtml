@model IEnumerable<_25DH190060_LTW.Models.ViewModel.CategoryStatsVM>

@{
    ViewBag.Title = "Thống Kê";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2 class="bg-success">THỐNG KÊ HÀNG HÓA TỪNG LOẠI</h2>

<table class="table table-bordered table-hover">
    <thead class="table-success" style="background-color: #d8ebd2;">
        <tr>
            <th class="font-weight-bold">LOẠI HÀNG</th>
            <th class="font-weight-bold">SỐ LƯỢNG</th>
            <th class="font-weight-bold">GIÁ CAO NHẤT</th>
            <th class="font-weight-bold">GIÁ THẤP NHẤT</th>
            <th class="font-weight-bold">GIÁ TRUNG BÌNH</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.CategoryName</td>
                <td>@item.ProductCount</td>
                <td>@item.MaxPrice.ToString("C0", System.Globalization.CultureInfo.GetCultureInfo("vi-VN"))</td>
                <td>@item.MinPrice.ToString("C0", System.Globalization.CultureInfo.GetCultureInfo("vi-VN"))</td>
                <td>@item.AvgPrice.ToString("C0", System.Globalization.CultureInfo.GetCultureInfo("vi-VN"))</td>
            </tr>
        }
    </tbody>
</table>

<div class="mb-4">
    <button type="button" class="btn btn-outline-secondary" onclick="toggleChart()">Xem biểu đồ</button>
</div>

<div id="chartSection" style="margin-top: 30px;">
    <h2 class="bg-success">BIỂU ĐỒ THỐNG KÊ</h2>
    <div id="piechart" style="width: 100%; height: 500px;"></div>
</div>

@section Scripts {
    <script type="text/javascript" src="https://www.gstatic.com/charts/loader.js"></script>
    <script type="text/javascript">
        google.charts.load('current', {'packages':['corechart']});
        google.charts.setOnLoadCallback(drawChart);

        function drawChart() {
            var data = new google.visualization.DataTable();
            data.addColumn('string', 'Loại hàng');
            data.addColumn('number', 'Số lượng');

            data.addRows([
                @foreach (var item in Model)
                {
                    <text>['@Html.Raw(HttpUtility.JavaScriptStringEncode(item.CategoryName))', @item.ProductCount],</text>
                }
            ]);

            var options = {
                title: 'TỶ LỆ HÀNG HÓA',
                is3D: true,
                fontSize: 14,
                chartArea: { width: '80%', height: '80%' }
            };

            var chart = new google.visualization.PieChart(document.getElementById('piechart'));
            chart.draw(data, options);
        }

        function toggleChart() {
            var section = document.getElementById('chartSection');
            if (section.style.display === "none") {
                section.style.display = "block";
                drawChart();
            } else {
                section.style.display = "none";
            }
        }
    </script>
}
