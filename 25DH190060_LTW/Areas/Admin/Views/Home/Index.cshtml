@model IEnumerable<_25DH190060_LTW.Models.ViewModel.CategoryStatVM>

@{
    ViewBag.Title = "Thống kê";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2 class="bg-success" style="padding: 10px;">THỐNG KÊ HÀNG HÓA TỪNG LOẠI</h2>

<table class="table table-bordered table-striped" style="margin-top: 15px;">
    <thead>
        <tr class="bg-success text-white">
            <th>LOẠI HÀNG</th>
            <th>SỐ LƯỢNG</th>
            <th>GIÁ CAO NHẤT</th>
            <th>GIÁ THẤP NHẤT</th>
            <th>GIÁ TRUNG BÌNH</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td><strong>@item.CategoryName</strong></td>
                <td>@item.ProductCount</td>
                <td>@string.Format("{0:N0} đ", item.MaxPrice)</td>
                <td>@string.Format("{0:N0} đ", item.MinPrice)</td>
                <td>@string.Format("{0:N0} đ", item.AvgPrice)</td>
            </tr>
        }
    </tbody>
</table>

<!-- Nút chuyển xuống xem biểu đồ -->
<div style="margin: 20px 0;">
    <a href="#chart-section" class="btn btn-default" style="border: 1px solid #ccc;">Xem biểu đồ</a>
</div>

<hr />

<!-- Khu vực Biểu đồ Google Chart -->
<div id="chart-section" style="margin-top: 30px;">
    <h3 class="bg-success" style="padding: 10px;">BIỂU ĐỒ THỐNG KÊ</h3>
    <h4 style="text-align: center; margin-top: 20px;">TỶ LỆ HÀNG HÓA</h4>

    <div id="piechart" style="width: 100%; height: 500px; display: flex; justify-content: center;"></div>
</div>

@section Scripts {
    <!-- Tải thư viện Google Chart -->
    <script type="text/javascript" src="https://www.gstatic.com/charts/loader.js"></script>
    <script type="text/javascript">
        google.charts.load('current', { 'packages': ['corechart'] });
        google.charts.setOnLoadCallback(drawChart);

        function drawChart() {
            // Nạp dữ liệu từ Razor Model vào DataTable của Google Charts
            var data = new google.visualization.DataTable();
            data.addColumn('string', 'Loại hàng');
            data.addColumn('number', 'Số lượng');

            data.addRows([
                @foreach (var item in Model)
                {
                    <text>['@Html.Raw(item.CategoryName)', @item.ProductCount],</text>
                }
            ]);

            var options = {
                title: '',
                is3D: false,
                chartArea: { width: '85%', height: '80%' },
                legend: { position: 'right', alignment: 'center' },
                fontSize: 14
            };

            var chart = new google.visualization.PieChart(document.getElementById('piechart'));
            chart.draw(data, options);
        }
    </script>
}