@model _25DH190060_LTW.Models.ViewModel.ProductSearchVM

@{
    ViewBag.Title = "Search Product";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<!-- Form tìm kiếm -->
@using (Html.BeginForm("Index", "Products", FormMethod.Get))
{
    <div class="form-group search-container">
        @Html.DropDownList("categoryId", (SelectList)ViewBag.CategoryID, "Tất cả danh mục", new
        {
            @class = "form-control",
            style = "max-width: 200px;"
        })

        @Html.TextBoxFor(m => m.SearchTerm, new
        {
            @class = "form-control",
            placeholder = "Nhập tên, mô tả...",
            style = "max-width: 300px;"
        })

        @Html.TextBoxFor(m => m.MinPrice, new
        {
            @class = "form-control",
            placeholder = "Giá tối thiểu",
            type = "number",
            style = "max-width: 150px;"
        })

        @Html.TextBoxFor(m => m.MaxPrice, new
        {
            @class = "form-control",
            placeholder = "Giá tối đa",
            type = "number",
            style = "max-width: 150px;"
        })

        <button type="submit" class="btn btn-primary">Tìm kiếm</button>
    </div>

    <!-- Tùy chọn sắp xếp -->
    <div class="form-group order-container">
        <span>Sắp xếp theo:</span>
        @Html.ActionLink("Tên tăng dần", "Index",
            new { sortOrder = "name_asc", searchTerm = Model.SearchTerm, minPrice = Model.MinPrice, maxPrice = Model.MaxPrice, categoryId = Model.CategoryID })
        |
        @Html.ActionLink("Tên giảm dần", "Index",
            new { sortOrder = "name_desc", searchTerm = Model.SearchTerm, minPrice = Model.MinPrice, maxPrice = Model.MaxPrice, categoryId = Model.CategoryID })
        |
        @Html.ActionLink("Giá tăng dần", "Index",
            new { sortOrder = "price_asc", searchTerm = Model.SearchTerm, minPrice = Model.MinPrice, maxPrice = Model.MaxPrice, categoryId = Model.CategoryID })
        |
        @Html.ActionLink("Giá giảm dần", "Index",
            new { sortOrder = "price_desc", searchTerm = Model.SearchTerm, minPrice = Model.MinPrice, maxPrice = Model.MaxPrice, categoryId = Model.CategoryID })
    </div>
}

@* Form kết quả tìm kiếm *@
@Html.Partial("PVListProduct", Model)
