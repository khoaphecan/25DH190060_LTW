@model _25DH190060_LTW.Models.ViewModel.ProductSearchVM
@using PagedList.Mvc;

<!-- Hiển thị danh sách sản phẩm -->
@if (Model.Products != null && Model.Products.Any())
{
    <h2 class="bg-success">DANH SÁCH SẢN PHẨM</h2>

    <table class="table table-bordered table-striped table-hover">
        <thead>
            <tr class="bg-success">
                <th style="width: 80px;">Hình ảnh</th>
                <th>Tên sản phẩm</th>
                <th style="width: 120px;" class="text-end">Đơn giá</th>
                <th style="width: 100px;" class="text-center">Tồn kho</th>
                <th style="width: 180px;">Danh mục</th>
                <th style="width: 180px; text-align: center;"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var product in Model.Products)
            {
                <tr>
                    <td class="text-center">
                        <img src="@Url.Content(product.ProductImage ?? "~/Content/images/default_img.png")" style="width: 50px; height: 60px; object-fit: contain; border: 1px solid #ddd; padding: 2px;" alt="@product.ProductName" />
                    </td>
                    <td>@Html.DisplayFor(modelItem => product.ProductName)</td>
                    <td class="text-end fw-bold text-danger">@product.ProductPrice.ToString("N0") đ</td>
                    <td class="text-center">@product.Quantity</td>
                    <td>@Html.DisplayFor(modelItem => product.Category.CategoryName)</td>
                    <td style="text-align: center;">
                        @Html.ActionLink("Sửa", "Edit", new { id = product.ProductID }, new { @class = "btn btn-primary btn-sm" })
                        @Html.ActionLink("Chi tiết", "Details", new { id = product.ProductID }, new { @class = "btn btn-secondary btn-sm" })
                        @Html.ActionLink("Xóa", "Delete", new { id = product.ProductID }, new { @class = "btn btn-danger btn-sm" })
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <!-- Hiển thị phân trang -->
    <div class="pagination-container">
        @Html.PagedListPager(Model.Products, page => Url.Action("Index", new { page, searchTerm = Model.SearchTerm, minPrice = Model.MinPrice, maxPrice = Model.MaxPrice, sortOrder = Model.SortOrder, categoryId = Model.CategoryID }))
    </div>
}
else
{
    <div class="alert alert-warning text-center">Không tìm được sản phẩm nào phù hợp.</div>
}

<div class="form-group mt-3">
    @Html.ActionLink("Thêm sản phẩm mới", "Create", null, new { @class = "btn btn-primary" })
</div>
