@model _25DH190060_LTW.Models.Product

<div class="panel panel-default border p-3 mb-3">
    <div class="row">
        <div class="col-md-3 text-center mb-2">
            <img src="@Url.Content(Model.ProductImage ?? "~/Content/images/default_img.png")" style="max-height: 200px; max-width: 100%; border: 1px solid #ddd; padding: 4px;" alt="@Model.ProductName" />
        </div>
        <div class="col-md-9">
            <dl class="row mb-0">
                <dt class="col-sm-3 font-weight-bold">Tên sản phẩm</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.ProductName)</dd>

                <dt class="col-sm-3 font-weight-bold">Mô tả</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.ProductDecription)</dd>

                <dt class="col-sm-3 font-weight-bold">Đơn giá</dt>
                <dd class="col-sm-9 text-danger fw-bold">@Model.ProductPrice.ToString("N0") đ</dd>

                <dt class="col-sm-3 font-weight-bold">Số lượng tồn</dt>
                <dd class="col-sm-9">@Model.Quantity</dd>

                <dt class="col-sm-3 font-weight-bold">Danh mục</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.Category.CategoryName)</dd>
            </dl>
        </div>
    </div>
</div>
