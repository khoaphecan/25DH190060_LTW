@model _25DH190060_LTW.Models.Order
@{
    ViewBag.Title = "OrderSuccess";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>XÁC NHẬN ĐƠN HÀNG</h2>
<h3>Thông tin đơn hàng</h3>
<div>
    <p><strong>Mã đơn hàng:</strong> @Model.OrderID</p>
    <p><strong>Ngày đặt hàng:</strong> @Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</p>
    <p><strong>Tổng số tiền:</strong> @Model.TotalAmount.ToString("N0") đ</p>
    <p><strong>Trạng thái thanh toán:</strong> @Model.PaymentStatus</p>
    <p><strong>Phương thức thanh toán:</strong> @Model.PaymentMethod</p>
    <p><strong>Phương thức giao hàng:</strong> @Model.DeliveryMethod</p>
    <p><strong>Địa chỉ giao hàng:</strong> @Model.AddressDelivery</p>
</div>

<h3>Chi tiết đơn hàng</h3>
<table class="table table-bordered">
    <thead>
        <tr>
            <th>Sản phẩm</th>
            <th>Số lượng</th>
            <th>Đơn giá</th>
            <th>Tổng giá</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.OrderDetail)
        {
            <tr>
                <td>@(item.Product != null ? item.Product.ProductName : "Mã SP: " + item.ProductID)</td>
                <td>@item.Quantity</td>
                <td>@item.UnitPrice.ToString("N0") đ</td>
                <td>@(item.TotalPrice.HasValue ? item.TotalPrice.Value.ToString("N0") : (item.Quantity * item.UnitPrice).ToString("N0")) đ</td>
            </tr>
        }
    </tbody>
</table>

<p>
    @Html.ActionLink("Tiếp tục mua hàng", "Index", "Home", null, new { @class = "btn btn-primary" })
    @Html.ActionLink("Xem đơn hàng của tôi", "MyOrder", "Order", null, new { @class = "btn btn-outline-secondary" })
</p>
