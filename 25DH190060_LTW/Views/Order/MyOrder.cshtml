@model _25DH190060_LTW.Models.ViewModel.MyOrderVM

@{
    ViewBag.Title = "Đơn hàng của tôi";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var tabs = new List<string> { "Tất cả đơn", "Chờ thanh toán", "Đang xử lý", "Đang vận chuyển", "Đã giao", "Đã hủy" };
}

<div class="container my-4">
    <h2 class="mb-3">ĐƠN HÀNG CỦA TÔI</h2>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- 1. THANH TABS TRẠNG THÁI -->
    <ul class="nav nav-pills mb-3">
        @foreach (var tab in tabs)
        {
            var isCurrent = (Model.ActiveStatus == tab) || (string.IsNullOrEmpty(Model.ActiveStatus) && tab == "Tất cả đơn");
            <li class="nav-item">
                <a href="@Url.Action("MyOrder", "Order", new { status = tab, searchTerm = Model.SearchTerm })"
                   class="nav-link @(isCurrent ? "active" : "")">
                    @tab
                </a>
            </li>
        }
    </ul>

    <!-- 2. TÌM KIẾM ĐƠN HÀNG -->
    @using (Html.BeginForm("MyOrder", "Order", FormMethod.Get, new { @class = "mb-4" }))
    {
        <input type="hidden" name="status" value="@Model.ActiveStatus" />
        <div class="input-group">
            <input type="text" name="searchTerm" class="form-control" value="@Model.SearchTerm" placeholder="Tìm kiếm theo mã đơn hoặc tên sản phẩm..." />
            <button type="submit" class="btn btn-primary">Tìm kiếm</button>
            @if (!string.IsNullOrEmpty(Model.SearchTerm))
            {
                <a href="@Url.Action("MyOrder", "Order", new { status = Model.ActiveStatus })" class="btn btn-secondary">Xóa tìm</a>
            }
        </div>
    }

    <!-- 3. DANH SÁCH ĐƠN HÀNG -->
    @if (Model.TotalUserOrders == 0)
    {
        <div class="alert alert-info text-center py-4">
            <h4>Bạn chưa có đơn hàng nào.</h4>
            <p class="mb-3">Hãy chọn những cuốn sách yêu thích để đặt hàng ngay!</p>
            <a href="@Url.Action("Index", "Home")" class="btn btn-primary">Bắt đầu mua sắm</a>
        </div>
    }
    else if (Model.OrderGroups == null || !Model.OrderGroups.Any() || !Model.OrderGroups.Any(g => g.Orders.Any()))
    {
        <div class="alert alert-warning text-center py-4">
            Không tìm thấy đơn hàng nào phù hợp với bộ lọc hiện tại.
        </div>
    }
    else
    {
        foreach (var group in Model.OrderGroups)
        {
            if (group.Orders != null && group.Orders.Any())
            {
                foreach (var order in group.Orders)
                {
                    var status = order.OrderStatusDisplay;
                    string badgeClass = "bg-secondary";
                    if (status == "Đã giao") { badgeClass = "bg-success"; }
                    else if (status == "Chờ thanh toán") { badgeClass = "bg-warning text-dark"; }
                    else if (status == "Đang xử lý" || status == "Đang vận chuyển") { badgeClass = "bg-info text-dark"; }
                    else if (status == "Đã hủy") { badgeClass = "bg-secondary"; }

                    <div class="card mb-3 shadow-sm">
                        <div class="card-header d-flex justify-content-between align-items-center bg-light">
                            <div>
                                <strong>Đơn hàng #@order.OrderID</strong>
                                <span class="text-muted ms-2">Ngày đặt: @order.OrderDate.ToString("dd/MM/yyyy HH:mm")</span>
                            </div>
                            <div>
                                <span class="badge @badgeClass fs-6">@status</span>
                            </div>
                        </div>

                        <div class="card-body p-0">
                            <table class="table table-bordered mb-0 align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th style="width: 80px;">Hình ảnh</th>
                                        <th>Tên sản phẩm</th>
                                        <th style="width: 100px;" class="text-center">Số lượng</th>
                                        <th style="width: 130px;" class="text-end">Đơn giá</th>
                                        <th style="width: 140px;" class="text-end">Thành tiền</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (order.OrderDetail != null && order.OrderDetail.Any())
                                    {
                                        foreach (var detail in order.OrderDetail)
                                        {
                                            var pImg = (detail.Product != null && !string.IsNullOrEmpty(detail.Product.ProductImage))
                                                ? detail.Product.ProductImage
                                                : "~/Content/images/default_img.png";
                                            var pName = detail.Product != null ? detail.Product.ProductName : ("Sản phẩm #" + detail.ProductID);
                                            var lineTotal = detail.TotalPrice.HasValue ? detail.TotalPrice.Value : (detail.Quantity * detail.UnitPrice);

                                            <tr>
                                                <td class="text-center">
                                                    <img src="@Url.Content(pImg)" alt="@pName" style="max-height: 50px; max-width: 60px;" class="img-thumbnail" />
                                                </td>
                                                <td>
                                                    <a href="@Url.Action("ProductDetails", "Home", new { id = detail.ProductID })" class="text-decoration-none fw-bold">
                                                        @pName
                                                    </a>
                                                </td>
                                                <td class="text-center">@detail.Quantity</td>
                                                <td class="text-end">@detail.UnitPrice.ToString("N0") đ</td>
                                                <td class="text-end fw-bold">@lineTotal.ToString("N0") đ</td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>

                        <div class="card-footer d-flex justify-content-between align-items-center bg-white">
                            <div>
                                <span>Thanh toán: <strong>@order.PaymentStatus</strong> (@order.PaymentMethod)</span>
                                <span class="ms-3">Giao hàng: <strong>@order.DeliveryMethod</strong></span>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <span class="fs-5 me-2">Tổng tiền: <strong class="text-danger">@order.TotalAmount.ToString("N0") đ</strong></span>
                                @if (status == "Chờ thanh toán" || status == "Đang xử lý")
                                {
                                    <a href="@Url.Action("CancelOrder", "Order", new { id = order.OrderID })"
                                       class="btn btn-danger btn-sm"
                                       onclick="return confirm('Bạn có chắc muốn hủy đơn hàng này?');">
                                        Hủy đơn
                                    </a>
                                }
                                <a href="@Url.Action("BuyAgain", "Order", new { orderId = order.OrderID })" class="btn btn-primary btn-sm">
                                    Mua lại
                                </a>
                                <a href="@Url.Action("OrderSuccess", "Order", new { id = order.OrderID })" class="btn btn-secondary btn-sm">
                                    Chi tiết
                                </a>
                            </div>
                        </div>
                    </div>
                }
            }
        }
    }
</div>
