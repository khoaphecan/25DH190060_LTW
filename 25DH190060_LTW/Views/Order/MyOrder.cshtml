@model IEnumerable<_25DH190060_LTW.Models.Order>
@{
    ViewBag.Title = "Đơn hàng của tôi";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string currentStatus = ViewBag.CurrentStatus as string ?? "Tất cả";
    string currentSearch = ViewBag.CurrentSearch as string ?? "";
}

<div class="container my-3">
    <h2>ĐƠN HÀNG CỦA TÔI</h2>

    <!-- Tabs Trạng thái đơn hàng -->
    <ul class="nav nav-tabs my-3">
        <li class="nav-item">
            <a class="nav-link @(currentStatus == "Tất cả" ? "active" : "")"
               href="@Url.Action("MyOrder", "Order", new { status = "Tất cả", search = currentSearch })">
                Tất cả đơn
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(currentStatus == "Chờ thanh toán" ? "active" : "")"
               href="@Url.Action("MyOrder", "Order", new { status = "Chờ thanh toán", search = currentSearch })">
                Chờ thanh toán
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(currentStatus == "Đang xử lý" ? "active" : "")"
               href="@Url.Action("MyOrder", "Order", new { status = "Đang xử lý", search = currentSearch })">
                Đang xử lý
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(currentStatus == "Đang vận chuyển" ? "active" : "")"
               href="@Url.Action("MyOrder", "Order", new { status = "Đang vận chuyển", search = currentSearch })">
                Đang vận chuyển
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(currentStatus == "Đã giao" ? "active" : "")"
               href="@Url.Action("MyOrder", "Order", new { status = "Đã giao", search = currentSearch })">
                Đã giao
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(currentStatus == "Đã hủy" ? "active" : "")"
               href="@Url.Action("MyOrder", "Order", new { status = "Đã hủy", search = currentSearch })">
                Đã hủy
            </a>
        </li>
    </ul>

    <!-- Thanh tìm kiếm đơn hàng theo Mã đơn hàng hoặc Tên sản phẩm -->
    <div class="my-3">
        @using (Html.BeginForm("MyOrder", "Order", FormMethod.Get, new { @class = "row g-2" }))
        {
            <input type="hidden" name="status" value="@currentStatus" />
            <div class="col-md-9">
                <input type="text" name="search" class="form-control"
                       placeholder="Tìm đơn hàng theo Mã đơn hàng hoặc Tên sản phẩm..."
                       value="@currentSearch" />
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-primary w-100">Tìm kiếm</button>
            </div>
        }
    </div>

    <!-- Danh sách đơn hàng -->
    @if (Model != null && Model.Any())
    {
        foreach (var order in Model)
        {
            <div class="panel panel-default border my-3 p-3">
                <div class="d-flex justify-content-between border-bottom pb-2 mb-2">
                    <div>
                        <strong>Đơn hàng #@order.OrderID</strong>
                        <span class="text-muted ms-3">Ngày đặt: @order.OrderDate.ToString("dd/MM/yyyy")</span>
                    </div>
                    <div>
                        <span class="badge bg-secondary">@order.PaymentStatus</span>
                    </div>
                </div>
                <table class="table table-bordered mb-2">
                    <tbody>
                        @if (order.OrderDetail != null)
                        {
                            foreach (var detail in order.OrderDetail)
                            {
                                <tr>
                                    <td style="width: 60px;">
                                        <img src="@Url.Content(detail.Product != null && !string.IsNullOrEmpty(detail.Product.ProductImage) ? detail.Product.ProductImage : "~/Content/images/default_img.png")"
                                             alt="" style="max-height: 50px; max-width: 50px;" />
                                    </td>
                                    <td>
                                        <strong>@(detail.Product != null ? detail.Product.ProductName : "Sản phẩm #" + detail.ProductID)</strong>
                                        <div class="text-muted small">Số lượng: @detail.Quantity | Đơn giá: @detail.UnitPrice.ToString("N0") đ</div>
                                    </td>
                                    <td class="text-end" style="width: 130px;">
                                        <strong>@((detail.Quantity * detail.UnitPrice).ToString("N0")) đ</strong>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <small class="text-muted">Địa chỉ nhận hàng: @order.AddressDelivery</small>
                    </div>
                    <div>
                        <span>Tổng tiền: <strong class="text-danger" style="font-size: 16px;">@order.TotalAmount.ToString("N0") đ</strong></span>
                        <a href="@Url.Action("OrderSuccess", "Order", new { id = order.OrderID })" class="btn btn-outline-primary btn-sm ms-3">
                            Xem chi tiết
                        </a>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <p class="text-center my-4">Không tìm thấy đơn hàng nào phù hợp.</p>
    }
</div>
