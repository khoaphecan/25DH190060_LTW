@model _25DH190060_LTW.Models.ViewModel.LoginVM
@{
    ViewBag.Title = "Đăng nhập";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .accountbtn {
        width: 275px;
        height: 40px;
        border: 1px solid #808080;
        margin: 5px 0;
    }
</style>

<div class="container my-4">
@using (Html.BeginForm("Login", "Account", FormMethod.Post, new { @class = "form-horizontal", role = "form" }))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    <div class="form-group mb-3">
        <h2 class="col-md-6" style="text-align:center;">Đăng nhập</h2>
    </div>
    @* Tên đăng nhập *@
    <div class="form-group row mb-3">
        @Html.LabelFor(m => m.Username, new { @class = "control-label col-md-2" })
        <div class="col-md-4">
            @Html.TextBoxFor(m => m.Username, new { @class = "form-control" })
            @Html.ValidationMessageFor(m => m.Username, "", new { @class = "text-danger" })
        </div>
    </div>
    @* Mật khẩu *@
    <div class="form-group row mb-3">
        @Html.LabelFor(m => m.Password, new { @class = "control-label col-md-2" })
        <div class="col-md-4">
            @Html.PasswordFor(m => m.Password, new { @class = "form-control" })
            @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger" })
        </div>
    </div>
    <div class="form-group row mb-3">
        <div class="col-md-offset-2 col-md-4">
            <input type="submit" value="Đăng nhập" class="btn btn-info accountbtn text-white" /><br />
            <p class="mt-2">Bạn Chưa Có Tài Khoản? <a href="@Url.Action("Register", "Account")">Đăng ký ngay</a></p>
        </div>
    </div>
}
</div>
