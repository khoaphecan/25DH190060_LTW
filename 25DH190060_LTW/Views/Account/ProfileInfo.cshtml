@model _25DH190060_LTW.Models.ViewModel.ProfileInfoVM
@{
    ViewBag.Title = "Thông tin tài khoản";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container my-4">
    <h2 class="text-primary mb-4"><i class="fa fa-user-circle"></i> THÔNG TIN TÀI KHOẢN</h2>

    <div class="row">
        <!-- Khối Thông tin cá nhân & Cập nhật -->
        <div class="col-md-7 mb-4">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white fw-bold">
                    <i class="fa fa-info-circle"></i> Thông tin cá nhân
                </div>
                <div class="card-body">
                    @using (Html.BeginForm("UpdateProfile", "Account", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        @Html.HiddenFor(m => m.CustomerID)

                        <div class="mb-3">
                            <label class="form-label text-muted">Tên đăng nhập:</label>
                            <input type="text" class="form-control" value="@Model.Username" readonly disabled />
                        </div>

                        <div class="mb-3">
                            @Html.LabelFor(m => m.CustomerName, new { @class = "form-label fw-bold" })
                            @Html.TextBoxFor(m => m.CustomerName, new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.CustomerName, "", new { @class = "text-danger" })
                        </div>

                        <div class="mb-3">
                            @Html.LabelFor(m => m.CustomerPhone, new { @class = "form-label fw-bold" })
                            @Html.TextBoxFor(m => m.CustomerPhone, new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.CustomerPhone, "", new { @class = "text-danger" })
                        </div>

                        <div class="mb-3">
                            @Html.LabelFor(m => m.CustomerEmail, new { @class = "form-label fw-bold" })
                            @Html.TextBoxFor(m => m.CustomerEmail, new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.CustomerEmail, "", new { @class = "text-danger" })
                        </div>

                        <div class="mb-3">
                            @Html.LabelFor(m => m.CustomerAddress, new { @class = "form-label fw-bold" })
                            @Html.TextBoxFor(m => m.CustomerAddress, new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.CustomerAddress, "", new { @class = "text-danger" })
                        </div>

                        <button type="submit" class="btn btn-primary"><i class="fa fa-save"></i> Lưu thay đổi</button>
                    }
                </div>
            </div>
        </div>

        <!-- Khối Đổi mật khẩu & Tiện ích -->
        <div class="col-md-5">
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-warning text-dark fw-bold">
                    <i class="fa fa-key"></i> Đổi mật khẩu
                </div>
                <div class="card-body">
                    @using (Html.BeginForm("ChangePassword", "Account", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label class="form-label fw-bold">Mật khẩu hiện tại:</label>
                            @Html.PasswordFor(m => m.CurrentPassword, new { @class = "form-control", required = "required" })
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Mật khẩu mới:</label>
                            @Html.PasswordFor(m => m.NewPassword, new { @class = "form-control", required = "required" })
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Xác nhận mật khẩu mới:</label>
                            @Html.PasswordFor(m => m.ConfirmNewPassword, new { @class = "form-control", required = "required" })
                        </div>

                        <button type="submit" class="btn btn-warning"><i class="fa fa-sync-alt"></i> Đổi mật khẩu</button>
                    }
                </div>
            </div>

            <div class="card shadow-sm">
                <div class="card-header bg-light fw-bold">
                    <i class="fa fa-bars"></i> Quản lý đơn hàng
                </div>
                <div class="card-body">
                    <p>Tra cứu tình trạng các đơn hàng đã đặt của bạn.</p>
                    <a href="@Url.Action("MyOrder", "Order")" class="btn btn-outline-info w-100">
                        <i class="fa fa-list-alt"></i> Xem lịch sử mua hàng
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
