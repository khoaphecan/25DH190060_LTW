@model _25DH190060_LTW.Models.ViewModel.ProductDetailsVM
@{
    ViewBag.Title = Model.product != null ? Model.product.ProductName : "Chi tiết sản phẩm";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" type="text/css" href="~/Content/myStyle/CustomerDetailProduct.css" />
<link rel="stylesheet" type="text/css" href="~/Content/myStyle/CustomerHome.css" />

<div class="container my-3">
    <div class="row bg-white p-3 rounded border">
        <!-- Khối bên trái: Ảnh sản phẩm -->
        <div class="col-md-5 text-center p-3 border-end">
            <img src="@Url.Content(!string.IsNullOrEmpty(Model.product.ProductImage) ? Model.product.ProductImage : "~/Content/images/default_img.png")"
                 alt="@Model.product.ProductName" class="img-fluid" style="max-height: 320px; object-fit: contain;" />
        </div>

        <!-- Khối ở giữa: Phần thông tin sản phẩm & đặt mua -->
        <div class="col-md-7 p-3">
            <h3 class="fw-bold mb-2">@Model.product.ProductName</h3>
            <p class="text-muted small mb-2">
                Danh mục: <span class="badge bg-secondary">@(Model.product.Category != null ? Model.product.Category.CategoryName : "")</span>
                <span class="ms-3">Đã bán: <strong>@(Model.product.OrderDetail != null ? Model.product.OrderDetail.Count() : 0)</strong></span>
            </p>
            <h4 class="text-danger fw-bold my-3">@Model.product.ProductPrice.ToString("N0") đ</h4>

            @using (Html.BeginForm("ProductDetails", "Home", FormMethod.Get, new { @class = "my-3" }))
            {
                @Html.Hidden("id", Model.product.ProductID)
                <div class="row align-items-center mb-3">
                    <label class="col-sm-3 col-form-label fw-bold">Số lượng:</label>
                    <div class="col-sm-4">
                        @Html.TextBoxFor(model => model.quantity, new { @class = "form-control text-center", type = "number", min = "1", onchange = "this.form.submit()" })
                    </div>
                </div>
                <div class="row align-items-center mb-3">
                    <span class="col-sm-3 fw-bold text-muted">Tạm tính:</span>
                    <div class="col-sm-6">
                        <span class="h5 text-danger fw-bold">@Model.estimatedValue.ToString("N0") đ</span>
                    </div>
                </div>
                <div class="mt-3">
                    @Html.ActionLink("Thêm vào giỏ hàng", "AddToCart", "Cart", new { id = Model.product.ProductID, quantity = Model.quantity }, new { @class = "btn btn-danger px-4 me-2" })
                    @Html.ActionLink("Tiếp tục mua sắm", "ProductList", "Home", null, new { @class = "btn btn-outline-secondary" })
                </div>
            }

            <hr class="my-3" />
            <h6 class="fw-bold">Mô tả sản phẩm:</h6>
            <div class="text-muted small" style="line-height: 1.6;">
                @Html.Raw(Html.Encode(Model.product.ProductDecription).Replace("\n", "<br/>"))
            </div>
        </div>
    </div>

    <!-- Khối Related Product -->
    <div class="my-4">
        @Html.Partial("_PVRelatedProduct", Model)
    </div>

    <!-- Khối Top Product -->
    <div class="my-4">
        @Html.Partial("_PVTopProduct", Model)
    </div>
</div>
