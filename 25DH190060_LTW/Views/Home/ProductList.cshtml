@model PagedList.IPagedList<_25DH190060_LTW.Models.Product>
@using PagedList.Mvc;
@{
    ViewBag.Title = ViewBag.CurrentCategory ?? "Danh sách sản phẩm";
    var categories = ViewBag.Categories as List<_25DH190060_LTW.Models.Category>;
}

<link rel="stylesheet" type="text/css" href="~/Content/myStyle/CustomerHome.css" />
<link rel="stylesheet" type="text/css" href="~/Content/PagedList.css" />

<div class="container my-3">
    <div class="row">
        <!-- Sidebar Danh mục -->
        <div class="col-md-3 mb-4">
            <div class="panel panel-default">
                <div class="panel-heading mb-2">
                    <strong>Danh mục sản phẩm</strong>
                </div>
                <div class="list-group">
                    <a href="@Url.Action("ProductList", "Home")" class="list-group-item @(ViewBag.CategoryID == null ? "active" : "")">
                        Tất cả sản phẩm
                    </a>
                    @if (categories != null)
                    {
                        foreach (var cat in categories)
                        {
                            <a href="@Url.Action("ProductList", "Home", new { categoryId = cat.CategoryID, searchTerm = ViewBag.SearchTerm, minPrice = ViewBag.MinPrice, maxPrice = ViewBag.MaxPrice, sortOrder = ViewBag.SortOrder })"
                               class="list-group-item @(ViewBag.CategoryID != null && (int)ViewBag.CategoryID == cat.CategoryID ? "active" : "")">
                                @cat.CategoryName
                            </a>
                        }
                    }
                </div>
            </div>
        </div>

        <!-- Danh sách sản phẩm -->
        <div class="col-md-9">
            <!-- Bộ lọc tìm kiếm & sắp xếp -->
            <div class="card mb-3 p-3">
                @using (Html.BeginForm("ProductList", "Home", FormMethod.Get, new { @class = "row g-2 align-items-center" }))
                {
                    if (ViewBag.CategoryID != null)
                    {
                        <input type="hidden" name="categoryId" value="@ViewBag.CategoryID" />
                    }
                    <div class="col-md-4">
                        <input type="text" name="searchTerm" class="form-control" placeholder="Tìm tên hoặc mô tả..." value="@ViewBag.SearchTerm" />
                    </div>
                    <div class="col-md-2">
                        <input type="number" name="minPrice" class="form-control" placeholder="Giá từ" value="@ViewBag.MinPrice" />
                    </div>
                    <div class="col-md-2">
                        <input type="number" name="maxPrice" class="form-control" placeholder="Đến giá" value="@ViewBag.MaxPrice" />
                    </div>
                    <div class="col-md-2">
                        <select name="sortOrder" class="form-control">
                            <option value="">Sắp xếp</option>
                            <option value="name_asc" @(ViewBag.SortOrder == "name_asc" ? "selected" : "")>Tên A-Z</option>
                            <option value="name_desc" @(ViewBag.SortOrder == "name_desc" ? "selected" : "")>Tên Z-A</option>
                            <option value="price_asc" @(ViewBag.SortOrder == "price_asc" ? "selected" : "")>Giá tăng dần</option>
                            <option value="price_desc" @(ViewBag.SortOrder == "price_desc" ? "selected" : "")>Giá giảm dần</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <button type="submit" class="btn btn-primary w-100">Lọc</button>
                    </div>
                }
            </div>

            <div class="d-flex justify-content-between align-items-center mb-3">
                <h3>@(ViewBag.CurrentCategory ?? "Tất cả sản phẩm")</h3>
                <span class="text-muted">Tổng số: @(Model != null ? Model.TotalItemCount : 0) sản phẩm</span>
            </div>

            @if (Model != null && Model.Any())
            {
                <div class="list-container">
                    @foreach (var product in Model)
                    {
                        <div class="lproduct-item">
                            <div>
                                <a href="@Url.Action("ProductDetails", "Home", new { id = product.ProductID })">
                                    <img src="@Url.Content(!string.IsNullOrEmpty(product.ProductImage) ? product.ProductImage : "~/Content/images/default_img.png")" alt="@product.ProductName" />
                                </a>
                            </div>
                            <div>
                                <p class="prodPrice">@product.ProductPrice.ToString("N0") đ</p>
                                <p class="prodName">
                                    <a href="@Url.Action("ProductDetails", "Home", new { id = product.ProductID })">
                                        @product.ProductName
                                    </a>
                                </p>
                                <p class="prodCate">@(product.Category != null ? product.Category.CategoryName : "")</p>
                                <p class="prodSale">Đã bán:&nbsp; @(product.OrderDetail != null ? product.OrderDetail.Count() : 0)</p>
                            </div>
                        </div>
                    }
                </div>

                <div class="pagination-container">
                    @Html.PagedListPager(Model, page => Url.Action("ProductList", new { categoryId = ViewBag.CategoryID, searchTerm = ViewBag.SearchTerm, minPrice = ViewBag.MinPrice, maxPrice = ViewBag.MaxPrice, sortOrder = ViewBag.SortOrder, page = page }))
                </div>
            }
            else
            {
                <p>Không có sản phẩm nào phù hợp.</p>
            }
        </div>
    </div>
</div>
