@model _25DH190060_LTW.Models.ViewModel.HomeProductVM
@{
    ViewBag.Title = "Trang chủ";
}
<link rel="stylesheet" type="text/css" href="~/Content/myStyle/CustomerHome.css" />

<!-- PHẦN BANNER DEMO -->
<section class="banner">
    <div class="banner-container">
        <h2>Chào mừng đến với MyStore</h2>
        <p>Hệ thống mua sắm trực tuyến đơn giản (Bản Demo)</p>
        <a href="#listProductSection" class="btnBanner">Bắt đầu mua sắm</a>
    </div>
</section>

<!-- PHẦN TÌM KIẾM SẢN PHẨM -->
<section class="searchProd" id="searchProd">
    <h2>Tìm kiếm sản phẩm</h2>
    @using (Html.BeginForm("Index", "Home", FormMethod.Get))
    {
        <div class="search-container">
            @Html.TextBoxFor(m => m.SearchTerm, new { @class = "search-input", placeholder = "Nhập tên, mô tả hoặc chủng loại sản phẩm..." })
            <button type="submit" class="search-button"><i class="fa fa-search me-1"></i> Tìm kiếm</button>
        </div>
    }
</section>

<!-- PHẦN SẢN PHẨM NỔI BẬT -->
@Html.Partial("_PVFeatureProduct", Model)

<!-- PHẦN SẢN PHẨM MỚI -->
<div id="listProductSection">
    @Html.Partial("_PVNewProduct", Model)
</div>
